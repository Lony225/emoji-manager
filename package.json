{
  "name": "emoji-manager",
  "productName": "Emoji Manager",
  "version": "1.1.1",
  "description": "跨平台表情包管理器：分类、标签、订阅同步",
  "author": "LONY",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "vite build && node scripts/build-electron.mjs",
    "start": "pnpm build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:dir": "pnpm build && electron-builder --dir",
    "samples": "node scripts/make-samples.mjs",
    "serve:samples": "node scripts/serve-samples.mjs",
    "e2e:electron": "node scripts/e2e-electron.mjs",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lony225/emoji-manager.git"
  },
  "homepage": "https://github.com/Lony225/emoji-manager"
}
